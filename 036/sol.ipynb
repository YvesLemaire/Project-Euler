   "source": [
    "S = 1 \n",
    "for c in ['', '0', '1']:\n",
    "    for i in range(1, 2 ** 10):\n",
    "        s = bin(i)[3:] # 0, 1 string of length <= 9\n",
    "        x = int('0b1' + s + c + s[::-1] + '1', 2)\n",
    "        if x <= 10 ** 6 and str(x) == str(x)[::-1]:\n",
    "           S += x\n",
    "S"
   ]
  }
